[MAIN]
load-plugins=pylint_django
django-settings-module=EduXJY.settings
fail-under=9.0
ignore=migrations,.venv,venv,staticfiles,media
module-rgx=^[a-zA-Z_][a-zA-Z0-9_]*$

[FORMAT]
max-line-length=100

[DESIGN]
max-args=10
max-attributes=10

[MESSAGES CONTROL]
disable=
    too-few-public-methods,
    too-many-ancestors,
    too-many-instance-attributes,
    duplicate-code,
    cyclic-import
