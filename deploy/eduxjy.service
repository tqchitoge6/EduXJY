[Unit]
Description=EduXJY Django teaching assistant (Gunicorn)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=eduxjy
Group=eduxjy
WorkingDirectory=/opt/EduXJY
EnvironmentFile=/opt/EduXJY/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/EduXJY/.venv/bin/gunicorn EduXJY.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 90 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3
UMask=007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
