# Copy this file to .env and fill in the values. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=please-generate-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DB_PATH=

# Any OpenAI-compatible endpoint. Leave AI_API_KEY empty to use retrieval-only fallback.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=
AI_TIMEOUT=45
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=800
AI_DAILY_LIMIT=100
AI_TOP_K=5

# Used by: python manage.py seed_demo
DEMO_PASSWORD=change-me-demo-password
