{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: EduXJY",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "127.0.0.1:8000"],
      "django": true,
      "justMyCode": true
    },
    {
      "name": "Pytest: AIQandA",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "AIQandA/tests"],
      "django": true,
      "justMyCode": false
    }
  ]
}
